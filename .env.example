
# DATABASE (PostgreSQL)

POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password


# RABBITMQ

RABBITMQ_DEFAULT_USER=your_rabbitmq_user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password
RABBITMQ_URL=amqp://your_rabbitmq_user:your_rabbitmq_password@rabbitmq:5672


# STORAGE PATHS

POSTGRES_DATA_PATH=/path/to/postgres/data
RABBITMQ_DATA_PATH=/path/to/rabbitmq/data


# ENVIRONMENT

NODE_ENV=development


# JWT CONFIG

AUTH_SECRET=your_access_token_secret
AUTH_SECRET_EXPIRES_IN=15m

AUTH_REFRESH_SECRET=your_refresh_token_secret
AUTH_REFRESH_SECRET_EXPIRES_IN=7d


# EMAIL CONFIG

EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password


# CORS / ORIGIN

ORIGIN=http://localhost:3000